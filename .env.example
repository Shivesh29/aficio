# =================================================================
# Aficio Environment Configuration Template
# Copy this file to .env and configure before starting Docker containers:
# cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# Security & Database Credentials
# -----------------------------------------------------------------
# Strong random password for PostgreSQL aficio_user
POSTGRES_PASSWORD=generate_a_strong_password_here

# 64-character base64-encoded cryptographically secure secret key for signing JWT tokens
# Generate on Linux/Mac: openssl rand -base64 48
# Generate on Windows PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RNGCryptoServiceProvider]::Create().GetBytes($b = New-Object byte[] 48); $b)
JWT_SECRET=generate_a_secure_jwt_secret_here

# -----------------------------------------------------------------
# External APIs & Services
# -----------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
# Ensure your frontend URL / domain is registered under Authorized JavaScript Origins in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Resend API Key for account verification and password reset emails
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Aficio <onboarding@yourdomain.com>

# YouTube Data API v3 key (for track audio playback sync)
# Recommended: apply HTTP Referrer or IP restriction in Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key

# -----------------------------------------------------------------
# Networking & CORS (Production Deployment)
# -----------------------------------------------------------------
# Comma-separated list of allowed CORS origins
# When deployed on Azure: http://<VM_IP>:5174,http://<VM_IP>:8080,https://yourdomain.com
AFICIO_CORS_ALLOWED_ORIGINS=http://localhost:*,http://localhost,http://localhost:5174,http://localhost:5173,http://localhost:3000

# Public URL of the frontend (used in verification email links)
AFICIO_FRONTEND_URL=http://localhost:5174

