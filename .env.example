# =================================================================
# Aficio Environment Configuration Template
# Copy this file to .env before starting Docker containers:
# cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# Security & Database Credentials (REQUIRED - Fail-Fast Enforced)
# -----------------------------------------------------------------
# Database password for PostgreSQL aficio_user
# Pre-filled with local development default. MUST be changed in production.
POSTGRES_PASSWORD=aficio_dev_password_change_in_prod

# 48-byte (64-character) Base64 cryptographically secure secret key for signing JWT tokens
# Pre-filled with local development default. MUST be regenerated in production.
# Generate on Linux/Mac: openssl rand -base64 48
# Generate on Windows PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=bLi3fr1Lw0KBG139hxwfL+jED4rvEpaKPLVoaCQGyv8miSDENA6L7UDbPVIgdBrY

# -----------------------------------------------------------------
# External APIs & Services (Optional for Local Core Testing)
# -----------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
# Ensure your frontend URL / domain is registered under Authorized JavaScript Origins in Google Cloud Console
GOOGLE_CLIENT_ID=549720788626-hj9h9nl4qju8rfcje93pcfkgg1h1hf2s.apps.googleusercontent.com

# Resend API Key for account verification and password reset emails
# Optional for local playback; required for sending live verification emails
RESEND_API_KEY=re_placeholder_for_production
RESEND_FROM=Aficio <onboarding@yourdomain.com>

# -----------------------------------------------------------------
# Networking & CORS (Development Defaults)
# -----------------------------------------------------------------
# Comma-separated list of allowed CORS origins
AFICIO_CORS_ALLOWED_ORIGINS=http://localhost:*,http://localhost,http://localhost:5174,http://localhost:5173,http://localhost:3000

# Public URL of the frontend (used in verification email links)
AFICIO_FRONTEND_URL=http://localhost:5174
